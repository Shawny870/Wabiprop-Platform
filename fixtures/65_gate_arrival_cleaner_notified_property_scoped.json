{
  "name": "gate arrival: the booking property's assigned cleaner is notified by TEMPLATE — property B's cleaner is not, and the owner send is unchanged",
  "comment": "Two properties, two active cleaners, so only property scoping can exclude anyone (fixture 61's exclusion pattern). Cleaner A's number is seeded as '0821110000' so formatPhone's 0->27 normalisation is exercised on the wire value. WABISTAY_CLEANER_GATE_TEMPLATE is set here, which is the post-Meta-approval state; the unconfigured (stubbed) state is covered in test/cleanergate.test.js.",
  "env": {
    "WABISTAY_CLEANER_GATE_TEMPLATE": "wabistay_cleaner_gate_arrival"
  },
  "seed": {
    "WS_Properties": [
      { "id": "recP1", "fields": { "Property Name": "Test Lodge", "Phone Number ID": "111000111000", "City": "Testville", "Notify Phone": "27831112222" } },
      { "id": "recP2", "fields": { "Property Name": "Other Lodge", "Phone Number ID": "222000222000", "City": "Otherville", "Notify Phone": "27839998888" } }
    ],
    "WS_Rooms": [
      { "id": "recR1", "fields": { "Room Name": "Room 1", "Status": "Available", "Property": ["recP1"] } },
      { "id": "recR2", "fields": { "Room Name": "Room 2", "Status": "Available", "Property": ["recP1"] } }
    ],
    "WS_Guests": [
      { "id": "recG1", "fields": { "Guest Name": "John Smith", "Phone Number": "27821234567", "Session State": "CONFIRMED" } }
    ],
    "WS_Bookings": [
      { "id": "recB1", "fields": { "Guest": ["recG1"], "Status": "Confirmed" } }
    ],
    "WS_Cleaners": [
      { "id": "recC1", "fields": { "Cleaner Name": "Thandi", "Phone Number": "0821110000", "Active": true, "Assigned Property": ["recP1"] } },
      { "id": "recC2", "fields": { "Cleaner Name": "Sipho", "Phone Number": "27829990000", "Active": true, "Assigned Property": ["recP2"] } }
    ]
  },
  "message": { "from": "27821234567", "text": "1" },
  "expect": {
    "status": 200,
    "writes": [
      { "op": "update", "table": "WS_Rooms", "id": "recR1", "fields": { "Status": "Occupied" } },
      { "op": "update", "table": "WS_Bookings", "id": "recB1", "fields": { "Status": "Checked In", "Checked In At": "re:^\\d{4}-\\d{2}-\\d{2}T", "Room": ["recR1"], "WS_Property": ["recP1"] } },
      { "op": "update", "table": "WS_Guests", "id": "recG1", "fields": { "Session State": "CHECKED_IN" } }
    ],
    "sends": [
      { "to": "27831112222", "includes": ["John Smith is at the gate", "Room 1 assigned", "Phone: 27821234567"] },
      {
        "to": "27821110000",
        "template": "wabistay_cleaner_gate_arrival",
        "params": ["Thandi", "John Smith", "Room 1", "Test Lodge"]
      },
      { "to": "27821234567", "includes": ["Welcome to Test Lodge!", "assigned *Room 1*", "1 - Check out"] }
    ]
  }
}
